  "stagingFolders": [
    {
      "pattern": "\\\\users\\\\public\\\\",
      "label": "\\Users\\Public"
    },
    {
      "pattern": "\\\\appdata\\\\local\\\\temp\\\\",
      "label": "user Temp"
    },
    {
      "pattern": "\\\\windows\\\\temp\\\\",
      "label": "\\Windows\\Temp"
    },
    {
      "pattern": "\\\\perflogs\\\\",
      "label": "\\PerfLogs"
    },
    {
      "pattern": "\\\\\\$recycle\\.bin\\\\",
      "label": "Recycle Bin"
    },
    {
      "pattern": "\\\\programdata\\\\[^\\\\]+\\.(exe|dll|ps1|bat|cmd|vbs|js|hta|scr)$",
      "label": "\\ProgramData root"
    },
    {
      "pattern": "\\\\windows\\\\tasks\\\\",
      "label": "\\Windows\\Tasks"
    },
    {
      "pattern": "\\\\windows\\\\debug\\\\",
      "label": "\\Windows\\debug"
    },
    {
      "pattern": "\\\\windows\\\\tracing\\\\",
      "label": "\\Windows\\Tracing"
    },
    {
      "pattern": "\\\\windows\\\\fonts\\\\[^\\\\]+\\.(exe|dll|ps1|bat)$",
      "label": "\\Windows\\Fonts"
    },
    {
      "pattern": "\\\\appdata\\\\roaming\\\\[^\\\\]+\\.(exe|dll|ps1|bat|cmd|vbs)$",
      "label": "AppData\\Roaming root"
    },
    {
      "pattern": "^(\\\\volume\\{[^}]*\\}|[a-z]:)?\\\\[^\\\\]+\\.(exe|dll|ps1|bat|cmd|vbs|hta|scr)$",
      "label": "drive root"
    },
    {
      "pattern": "\\\\intel\\\\[^\\\\]+\\.(exe|dll)$",
      "label": "\\Intel"
    }
  ],
  "commandLines": [
    {
      "pattern": "vssadmin(\\.exe)?\\s+.*delete\\s+shadows",
      "label": "Shadow copies deleted (vssadmin)",
      "severity": "Critical"
    },
    {
      "pattern": "wmic(\\.exe)?\\s+.*shadowcopy\\s+delete",
      "label": "Shadow copies deleted (wmic)",
      "severity": "Critical"
    },
    {
      "pattern": "Win32_ShadowCopy.*(Delete|Remove)",
      "label": "Shadow copies deleted (WMI)",
      "severity": "Critical"
    },
    {
      "pattern": "bcdedit(\\.exe)?.*(recoveryenabled\\s+no|bootstatuspolicy\\s+ignoreallfailures)",
      "label": "Recovery disabled (bcdedit)",
      "severity": "Critical"
    },
    {
      "pattern": "wbadmin(\\.exe)?\\s+delete",
      "label": "Backups deleted (wbadmin)",
      "severity": "Critical"
    },
    {
      "pattern": "wevtutil(\\.exe)?\\s+(cl|clear-log)\\b",
      "label": "Event log cleared (wevtutil)",
      "severity": "Critical"
    },
    {
      "pattern": "Clear-EventLog|Remove-EventLog",
      "label": "Event log cleared (PowerShell)",
      "severity": "Critical"
    },
    {
      "pattern": "comsvcs(\\.dll)?[\\s,#]+.*minidump",
      "label": "LSASS dump via comsvcs.dll",
      "severity": "Critical"
    },
    {
      "pattern": "procdump(64)?(\\.exe)?\\s.*lsass",
      "label": "LSASS dump via procdump",
      "severity": "Critical"
    },
    {
      "pattern": "sekurlsa::|lsadump::|kerberos::golden|privilege::debug",
      "label": "Mimikatz command",
      "severity": "Critical"
    },
    {
      "pattern": "reg(\\.exe)?\\s+save\\s+hklm\\\\(sam|system|security)",
      "label": "Registry hive dump (SAM/SYSTEM/SECURITY)",
      "severity": "Critical"
    },
    {
      "pattern": "ntdsutil.*(ifm|create\\s+full)",
      "label": "NTDS.dit dump (ntdsutil)",
      "severity": "Critical"
    },
    {
      "pattern": "\\\\\\\\127\\.0\\.0\\.1\\\\ADMIN\\$\\\\__\\d",
      "label": "Impacket wmiexec/smbexec output redirect",
      "severity": "Critical"
    },
    {
      "pattern": "cmd(\\.exe)?\\s+/Q\\s+/c\\s+.*1>\\s*\\\\\\\\",
      "label": "Impacket-style remote command",
      "severity": "Critical"
    },
    {
      "pattern": "%COMSPEC%\\s+/Q\\s+/c\\s+echo",
      "label": "Impacket smbexec service command",
      "severity": "Critical"
    },
    {
      "pattern": "powershell.*\\s-(e|ec|en|enc|enco|encod|encode|encoded|encodedcommand)\\s+[A-Za-z0-9+/=]{20,}",
      "label": "Encoded PowerShell command",
      "severity": "High"
    },
    {
      "pattern": "FromBase64String",
      "label": "PowerShell base64 decode",
      "severity": "Medium"
    },
    {
      "pattern": "\\b(IEX|Invoke-Expression)\\b.*(DownloadString|DownloadData|Net\\.WebClient|iwr|Invoke-WebRequest|irm)",
      "label": "PowerShell download-and-execute",
      "severity": "Critical"
    },
    {
      "pattern": "(DownloadString|DownloadFile|DownloadData)\\s*\\(\\s*['\"]?https?://",
      "label": "PowerShell download cradle",
      "severity": "High"
    },
    {
      "pattern": "Invoke-WebRequest|\\biwr\\s+https?://|Start-BitsTransfer",
      "label": "PowerShell download",
      "severity": "Medium"
    },
    {
      "pattern": "-(nop|noprofile)\\b.*-(w|windowstyle)\\s+(h|hidden)",
      "label": "Hidden PowerShell window",
      "severity": "Medium"
    },
    {
      "pattern": "(Set-MpPreference|Add-MpPreference).*(Disable|Exclusion)",
      "label": "Defender disabled / exclusion added",
      "severity": "High"
    },
    {
      "pattern": "certutil(\\.exe)?.*(-urlcache|-verifyctl).*https?://",
      "label": "certutil download",
      "severity": "High"
    },
    {
      "pattern": "certutil(\\.exe)?.*-decode",
      "label": "certutil decode",
      "severity": "Medium"
    },
    {
      "pattern": "bitsadmin(\\.exe)?.*/(transfer|addfile).*https?://",
      "label": "bitsadmin download",
      "severity": "High"
    },
    {
      "pattern": "mshta(\\.exe)?\\s+(\"|')?(https?|vbscript|javascript):",
      "label": "mshta remote/script execution",
      "severity": "High"
    },
    {
      "pattern": "regsvr32(\\.exe)?.*/i:\\s*https?://",
      "label": "regsvr32 remote scriptlet (Squiblydoo)",
      "severity": "High"
    },
    {
      "pattern": "rundll32(\\.exe)?\\s+.*javascript:",
      "label": "rundll32 script execution",
      "severity": "High"
    },
    {
      "pattern": "net1?(\\.exe)?\\s+user\\s+\\S+\\s+\\S+\\s+/add",
      "label": "Local account created (net user /add)",
      "severity": "High"
    },
    {
      "pattern": "net1?(\\.exe)?\\s+localgroup\\s+(administrators|\"remote desktop users\")\\s+\\S+\\s+/add",
      "label": "User added to admin/RDP group",
      "severity": "High"
    },
    {
      "pattern": "net1?(\\.exe)?\\s+group\\s+\"?domain admins\"?\\s+.*/add",
      "label": "User added to Domain Admins",
      "severity": "Critical"
    },
    {
      "pattern": "schtasks(\\.exe)?\\s+/create",
      "label": "Scheduled task created (schtasks)",
      "severity": "Medium"
    },
    {
      "pattern": "\\bsc(\\.exe)?\\s+(\\\\\\\\\\S+\\s+)?create\\s",
      "label": "Service created (sc)",
      "severity": "Medium"
    },
    {
      "pattern": "reg(\\.exe)?\\s+add\\s+.*\\\\CurrentVersion\\\\Run",
      "label": "Run key added (reg add)",
      "severity": "High"
    },
    {
      "pattern": "reg(\\.exe)?\\s+add\\s+.*(DisableAntiSpyware|DisableRealtimeMonitoring|fDenyTSConnections)",
      "label": "Security setting changed (reg add)",
      "severity": "High"
    },
    {
      "pattern": "netsh(\\.exe)?\\s+(advfirewall\\s+set\\s+\\S+\\s+state\\s+off|firewall\\s+set\\s+opmode\\s+disable)",
      "label": "Firewall disabled (netsh)",
      "severity": "High"
    },
    {
      "pattern": "netsh(\\.exe)?\\s+interface\\s+portproxy\\s+add",
      "label": "Port proxy added (netsh)",
      "severity": "High"
    },
    {
      "pattern": "\\bnltest(\\.exe)?\\s+/(domain_trusts|dclist)",
      "label": "Domain discovery (nltest)",
      "severity": "Medium"
    },
    {
      "pattern": "\\bwhoami(\\.exe)?\\s+/(all|priv|groups)",
      "label": "Privilege discovery (whoami)",
      "severity": "Suspicious"
    },
    {
      "pattern": "net1?(\\.exe)?\\s+(group\\s+\"?domain admins\"?|user\\s+/domain)",
      "label": "Domain account discovery (net)",
      "severity": "Medium"
    },
    {
      "pattern": "\\b(7z|7za|rar|winrar)(\\.exe)?\\s+a\\s.*(-p|-hp)",
      "label": "Password-protected archive created",
      "severity": "High"
    },
    {
      "pattern": "\\brclone(\\.exe)?\\s+(copy|sync|move)",
      "label": "rclone transfer",
      "severity": "Critical"
    },
    {
      "pattern": "\\\\\\\\[^\\\\\\s]+\\\\(ADMIN|C)\\$\\\\",
      "label": "Admin share path in command",
      "severity": "Medium"
    },
    {
      "pattern": "Invoke-(Mimikatz|Kerberoast|ShareFinder|BloodHound|Portscan|SMBExec|WMIExec|TokenManipulation)",
      "label": "Offensive PowerShell function",
      "severity": "Critical"
    },
    {
      "pattern": "\\bAmsiUtils\\b|amsiInitFailed",
      "label": "AMSI bypass",
      "severity": "Critical"
    },
    {
      "pattern": "New-Object\\s+(System\\.)?Net\\.Sockets\\.TCPClient",
      "label": "PowerShell TCP client (reverse shell)",
      "severity": "Critical"
    },
    {
      "pattern": "\\bwmic(\\.exe)?\\s+.*/node:\\s*\\S+.*\\bprocess\\s+call\\s+create",
      "label": "Remote process via WMIC (/node)",
      "severity": "High"
    },
    {
      "pattern": "\\bwmic(\\.exe)?\\s+(/\\S+\\s+)*process\\s+call\\s+create",
      "label": "Process created via WMIC",
      "severity": "Medium"
    },
    {
      "pattern": "(Invoke-WmiMethod|Invoke-CimMethod|\\[wmiclass\\]).*Win32_Process.*\\bCreate\\b",
      "label": "Process created via WMI (PowerShell)",
      "severity": "High"
    },
    {
      "pattern": "(Set-WmiInstance|New-CimInstance|Register-WmiEvent).*(__EventFilter|__EventConsumer|CommandLineEventConsumer|ActiveScriptEventConsumer|__FilterToConsumerBinding)",
      "label": "WMI persistence created (PowerShell)",
      "severity": "Critical"
    },
    {
      "pattern": "\\bmofcomp(\\.exe)?\\s+\\S+",
      "label": "MOF file compiled (mofcomp)",
      "severity": "Medium"
    },
    {
      "pattern": "\\bClear-History\\b|Remove-Item\\b.*ConsoleHost_history|Set-PSReadLineOption\\b.*-HistorySaveStyle\\s+SaveNothing",
      "label": "PowerShell history cleared or disabled",
      "severity": "High"
    }
  ],
  "shellbagFolderNames": "\\b(mimikatz|rclone|exfil|loot|dump|dumps|hashes|creds|passwords?|sharphound|bloodhound|lazagne|procdump|psexec|cobalt|beacon|tools?|hack|payloads?|ransom|staging)\\b|\\\\\\\\[^\\\\]+\\\\(ADMIN|[A-Z])\\$",
  "webAttacks": [
    {
      "label": "SQL injection",
      "pattern": "union(?:\\s|/\\*.*?\\*/)+(?:all(?:\\s|/\\*.*?\\*/)+)?select\\b|\\b(?:and|or)\\s+\\d+\\s*=\\s*\\d+|'\\s*(?:or|and)\\s+'?\\d|'\\s*(?:or|and)\\s+'[^']*'\\s*=\\s*'|\\bsleep\\s*\\(\\s*\\d|\\bbenchmark\\s*\\(|information_schema|\\bwaitfor\\s+delay\\b|\\bextractvalue\\s*\\(|\\bupdatexml\\s*\\(|concat\\s*\\([^)]*0x3a"
    },
    {
      "label": "Path traversal / LFI",
      "pattern": "\\.\\.[/\\\\]|/etc/(?:passwd|shadow|hosts|group)\\b|/proc/self/|php://(?:filter|input)|\\bfile://|expect://|zip://"
    },
    {
      "label": "Command injection / RCE",
      "pattern": "(?:[;|`]|&&)\\s*(?:id|whoami|uname|cat|wget|curl|bash|sh|nc|python3?|perl)\\b|\\$\\((?:id|whoami|curl|wget)|\\b(?:eval|system|exec|passthru|shell_exec|base64_decode)\\s*\\(|\\$\\{jndi:"
    },
    {
      "label": "XSS",
      "pattern": "<\\s*script|javascript:|\\bon(?:error|load|mouseover)\\s*=|<\\s*svg[^>]*on\\w+\\s*="
    },
    {
      "label": "Exchange ProxyShell / ProxyNotShell",
      "pattern": "/autodiscover/autodiscover\\.json\\?@|/autodiscover\\.json.*(?:powershell|mapi/nspi)|/mapi/nspi/\\?&email=autodiscover"
    }
  ],
  "webSensitiveProbe": "/\\.env\\b|/\\.git/|/\\.svn/|/\\.htpasswd|/\\.htaccess|/\\.aws/|/\\.ssh/|wp-config\\.php|/config\\.php\\.(?:bak|old|save)|\\.(?:sql|bak|old|swp)(?:$|\\?)|/phpmyadmin|/adminer|/server-status|/actuator\\b",
  "webUploadDirScript": "/(?:wp-content/uploads|uploads?|images?|img|files|media|tmp|temp|cache|assets/upload)/[^?#]*\\.(?:php\\d?|phtml|phar|jsp|jspx|aspx?|cgi|pl)(?:$|[?#])",
  "webShellNames": "/(?:cmd|shell|c99|r57|wso|b374k|alfa|webshell|backdoor|up|uploader)\\.(?:php\\d?|phtml|jsp|aspx?)(?:$|[?#])",
  "webCommandParam": "[?&](?:cmd|exec|command|execute|shell|c|run|code)=(?<cmd>[^&#]+)",
