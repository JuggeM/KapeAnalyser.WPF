<UserControl x:Class="KapeAnalyser.WPF.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Detection" Style="{StaticResource SectionTitle}"/>

        <TextBlock Text="Detection rules file — tools, staging folders and command-line patterns" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding RulesPathText, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"
                     ToolTip="Empty = rules.json next to KapeAnalyser.WPF.exe"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource StandardButton}" Command="{Binding BrowseRulesCommand}"/>
            <Button Grid.Column="2" Content="Open" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Command="{Binding OpenRulesCommand}"
                    ToolTip="Open the rules file in your editor"/>
            <Button Grid.Column="3" Content="Reload" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Command="{Binding ReloadRulesCommand}"
                    ToolTip="Read the rules file again (also done at the start of every run)"/>
        </Grid>
        <TextBlock Text="{Binding RulesStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RulesOk}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Separator/>

        <TextBlock Text="Brute force threshold (failed logons from one source)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Config.BruteForceThreshold, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"/>

        <TextBlock Text="$MFT: only list lower-severity files created within this many days of the newest file (0 = all)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Config.FileSystemRecencyDays, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"/>

        <Separator/>

        <TextBlock Text="Extra keywords — flagged HIGH in file names, paths and command lines (one per line)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ExtraKeywordsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,4"/>
        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                   Text="Use for names from the ticket or threat intel, e.g. a malware file name or a staging folder. The rules file already covers common attacker and dual-use tools (credential theft, lateral movement, remote access, exfiltration, …); add permanent ones there."/>

        <TextBlock Text="Whitelisted path fragments — never flagged (one per line)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding WhitelistText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </StackPanel>
</UserControl>
