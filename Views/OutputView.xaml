<UserControl x:Class="KapeAnalyser.WPF.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Output" Style="{StaticResource SectionTitle}"/>

        <TextBlock Text="Output directory" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Config.OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource StandardButton}" Command="{Binding BrowseOutputCommand}"/>
            <Button Grid.Column="2" Content="Open" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}"/>
        </Grid>
        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"
                   Text="Per host: QuickWins.txt/.rtf, Findings.csv (open in Timeline Explorer), Logons.csv, IocHits.csv. Case: CaseSummary.txt and CaseFindings.csv. A host is processed once — delete its folder to redo it."/>

        <Separator/>

        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="▶  Run analysis" Style="{StaticResource PrimaryButton}" Width="140"
                    Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"/>
            <Button Grid.Column="1" Content="■  Cancel" Style="{StaticResource StandardButton}" Width="90" Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Grid.Column="2" Text="{Binding RunStatusText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,0"/>
            <TextBlock Grid.Column="3" Text="{Binding ProgressText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,0"/>
        </Grid>

        <ProgressBar Height="4" Margin="0,0,0,12" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10,8">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="11" Margin="0,1"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
